{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"paths": {
			"$lib": [
				"./src/lib"
			],
			"$lib/*": [
				"./src/lib/*"
			],
			"$src/*": [
				"./src/*"
			],
			"$app/types": [
				"./.svelte-kit/types/index.d.ts"
			]
		},
		"allowImportingTsExtensions": true
	},
	"include": [
		"src",
		"test",
		"*",
		"tests/**/*.ts",
		".storybook/**/*.ts",
		"scripts/**/*.ts",
		"../commitlint.config.ts"
	]
}
